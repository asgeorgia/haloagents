{
  "name": "halo-agent",
  "productName": "Halo",
  "version": "1.4.2",
  "description": "Floating, cross-platform AI agent: local-first models with cloud escalation.",
  "main": "src/main.js",
  "author": {
    "name": "Magenta AI Lab Inc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asgeorgia/haloagents.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "csv-parse": "5",
    "electron-updater": "^6.6.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.halo.agent",
    "productName": "Halo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "asgeorgia",
        "repo": "haloagents",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Magenta AI Lab Inc"
    },
    "nsis": {
      "artifactName": "Halo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Halo-Portable-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "Halo-${version}.${ext}"
    }
  },
  "homepage": "https://haloagents.app"
}
